# Shared
NODE_ENV=development

# PostgreSQL
POSTGRES_USER=pharma
POSTGRES_PASSWORD=pharma_dev_password
POSTGRES_DB=pharma_catalogue
POSTGRES_PORT=5432
DATABASE_URL=postgresql://pharma:pharma_dev_password@localhost:5432/pharma_catalogue?schema=public
# On Vercel + Supabase: use Transaction pooler (port 6543, ?pgbouncer=true&schema=public).
# Keep direct DB URL here for prisma migrate (local / CI):
DIRECT_URL=postgresql://pharma:pharma_dev_password@localhost:5432/pharma_catalogue?schema=public

# API
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=0
MAX_UPLOAD_BYTES=5242880

# Object storage — Cloudinary (preferred for demo)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pharma-catalogue

# Object storage — S3-compatible (optional alternative)
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=pharma-catalogue
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Admin (Next.js)
# Local: point at API port. On Vercel: omit or set to "/api" (same-origin rewrite).
# Do NOT set API_URL yourself on Vercel — it is injected by the admin→api service binding.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
ADMIN_APP_URL=http://localhost:3000

# Mobile (Expo)
# Local API, or production public URL e.g. https://your-app.vercel.app/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
